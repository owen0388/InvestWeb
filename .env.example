# =====================================================================
# 投资情报与动态资产配置系统 - 环境变量示例
# 复制为 .env 后按需填写。所有密钥均为空时，采集/存储/目录/评分等
# 不依赖密钥的模块仍可正常运行，AI 分析会显示“未配置”。
# =====================================================================

# ---------- 基础 ----------
APP_ENV=dev
DATABASE_URL=sqlite:///./data/invest.db
# 生产可改为: postgresql+psycopg://user:pass@localhost:5432/invest
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# 是否随 API 进程启动定时任务（1=启用，0=关闭）
SCHEDULER_ENABLED=1
TIMEZONE=Asia/Shanghai

# ---------- 数据源（按需，均可留空） ----------
# FRED 宏观数据（免费申请：https://fred.stlouisfed.org/docs/api/api_key.html）
FRED_API_KEY=
# Tushare Pro（可选，未配置时状态为“缺少密钥”）
TUSHARE_TOKEN=
# 是否启用 GDELT 全球新闻（免费，但有频率限制）
GDELT_ENABLED=0

# 采集参数
HTTP_TIMEOUT=15
HTTP_MAX_RETRIES=2
NEWS_MAX_ITEMS_PER_RUN=80

# ---------- 大模型（OpenAI 兼容协议，可换厂商） ----------
# 不填写 LLM_API_KEY 时，AI 分析模块显示未配置，系统使用规则引擎并明确标注
LLM_ENABLED=0
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL_CHEAP=deepseek-chat
LLM_MODEL_STRONG=deepseek-reasoner
LLM_TIMEOUT=60
LLM_MAX_INPUT_TOKENS=6000
LLM_MAX_OUTPUT_TOKENS=1200
# 预算（美元），用于成本控制与降频
LLM_DAILY_BUDGET_USD=0.50
LLM_MONTHLY_BUDGET_USD=10.00
# 单次调用估价（美元/百万 token），用于成本估算
LLM_CHEAP_INPUT_PRICE=0.27
LLM_CHEAP_OUTPUT_PRICE=1.10
LLM_STRONG_INPUT_PRICE=0.55
LLM_STRONG_OUTPUT_PRICE=2.19

# ---------- 通知 ----------
WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_TO=
